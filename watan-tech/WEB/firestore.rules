rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ضع_هنا_UID_الأدمن';
    }
    match /messages/{id} {
      // الزوار: إنشاء فقط مع تحقق صارم
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','type','message','createdAt','status'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && request.resource.data.email.size() <= 150
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 20
        && request.resource.data.type in ['اقتراح','شكوى','ملاحظة','استفسار','أخرى']
        && request.resource.data.message is string && request.resource.data.message.size() >= 5 && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'new';
      // الأدمن فقط: قراءة وتعديل وحذف
      allow read, delete: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
